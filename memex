#!/usr/bin/env bash
#
# memex: run a role's adapters for the working copy in the current
# directory.
#
#   memex bindings
#   memex review [CHANGE]
#   memex history [CHANGE]
#   memex ROLE COMMAND [ARGUMENTS]
#
# Bindings come from, per role, the first of: $GIT_DIR/memex/bindings,
# ${XDG_CONFIG_HOME:-~/.config}/memex/bindings for a matching remote, and
# .memex in the working copy. Nothing is guessed. A command runs once per
# binding of the role; their RECORDs are printed one after another. Never
# prompts.
#

set -e

die() {
  echo "$*" >&2
  exit 1
}

SPECS=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/skills/memex

usage() {
  cat << EOF
Usage: $0 COMMAND [ARGUMENTS], in a working copy

  bindings                  what each role is bound to
  review [CHANGE]           a change and its review threads
  history [CHANGE]          every version of a change, uploaded or local,
                            newest first
  ROLE COMMAND [ARGUMENTS]  a command of ROLE: discussion, tracker, ci or
                            code

CHANGE defaults to the change of HEAD. A COMMIT may be any git revision,
and defaults to HEAD. Output is RECORDs, one JSON object per line. Exit
status 2: the bound adapter lacks the command.

PROTOCOL.md specifies the RECORDs, ROLE.md each role's commands, in
  $SPECS
EOF
}

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/memex/bindings

# Prints ROLE ADAPTER ADDR lines of a bindings file, without comments
read_bindings() {
  [ -f "$1" ] || return 0
  grep -Ev '^[[:space:]]*(#|$)' "$1" || true
}

# Prints the ROLE ADAPTER ADDR lines of the user's config for REPO's
# remotes
user_bindings() {
  local remotes
  local remote
  local rest
  [ -f "$CONFIG" ] || return 0
  remotes=$(git -C "$REPO" remote -v | cut -f2 | cut -d' ' -f1 | sort -u)
  read_bindings "$CONFIG" | while read -r remote rest; do
    if grep -qxF "$remote" <<< "$remotes"; then
      echo "$rest"
    fi
  done
}

# Prints the ADAPTER ADDR lines bound to a role, from the first source
# that binds it
bindings() {
  local source
  local found
  for source in git_dir user project; do
    case $source in
      git_dir) found=$(read_bindings "$GIT_DIR/memex/bindings") ;;
      user) found=$(user_bindings) ;;
      project) found=$(read_bindings "$REPO/.memex") ;;
    esac
    found=$(awk -v role="$1" '$1 == role { print $2, $3 }' <<< "$found")
    if [ -n "$found" ]; then
      echo "$found"
      return
    fi
  done
}

# Runs a command with each binding of ROLE; succeeds if one succeeds,
# exits 2 if every adapter says not supported. Only a single adapter
# reads stdin.
run() {
  local role=$1
  local adapter
  local addr
  local status
  local result=1
  local all_unsupported=1
  local lines
  shift
  # ADAPTER - turns the role off
  lines=$(bindings "$role" | awk '$1 != "-"')
  [ -n "$lines" ] || die "No $role binding for $REPO"
  # With one binding the adapter gets stdin, e.g. a draft's text
  if [ $(wc -l <<< "$lines") -eq 1 ]; then
    read -r adapter addr <<< "$lines"
    exec "$adapter" "$addr" "$role" "$@"
  fi
  while read -r adapter addr; do
    status=0
    "$adapter" "$addr" "$role" "$@" < /dev/null || status=$?
    [ $status -eq 0 ] && result=0
    [ $status -ne 2 ] && all_unsupported=
  done <<< "$lines"
  if [ $result -ne 0 -a -n "$all_unsupported" ]; then
    exit 2
  fi
  exit $result
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi

REPO=$(git rev-parse --show-toplevel 2> /dev/null) ||
  die "Not in a git working copy: $PWD"
GIT_DIR=$(git rev-parse --absolute-git-dir)

# Prints the change RECORD of CHANGE, or of HEAD's change
change() {
  if [ -n "$1" ]; then
    "$0" discussion change "$1"
  else
    "$0" discussion locate "$(git rev-parse HEAD)"
  fi
}

# Prints the change RECORD of CHANGE, or of HEAD's change, then its thread
# RECORDs
review() {
  local record
  record=$(change "$1") || exit 1
  printf '%s\n' "$record"
  "$0" discussion threads "$(jq -r .id <<< "$record")"
}

# Prints a version RECORD for each version of CHANGE, or of HEAD's change,
# newest first: its revisions on the review, and its commits that are
# only in workspaces or upstream. Without a code binding, the revisions.
history() {
  local change
  local id
  local versions='[]'
  change=$(change "$1") || exit 1
  id=$(jq -r '[.links[] | select(.[0] == "change-id") | .[1]][0] // empty' \
    <<< "$change")
  if [ -n "$id" -a -n "$(bindings code)" ]; then
    versions=$("$0" code versions "$id" | jq -sc .) || exit 1
  fi
  jq -c --argjson versions "$versions" '
    # Seconds since the epoch of an RFC 3339 time, with any offset
    def epoch: (.[0:19] + "Z" | fromdateiso8601)
      - (.[19:] | sub("^\\.[0-9]+"; "")
        | if . == "Z" or . == "" then 0
          else (.[0:1] + "1" | tonumber)
            * ((.[1:3] | tonumber) * 3600 + (.[4:6] | tonumber) * 60) end);
    . as $change
    | ($versions | map({key: .data.commit, value: .}) | from_entries)
      as $local
    | [.data.revisions[] | . as $r | {
        revision: .id, commit: .commit, time: .created,
        current: (.id == $change.data.current),
        where: (["server"] + (($local[$r.commit].data.where // [])
          - ["server"]))}]
    | . as $uploaded
    | . + [$versions[] | select(.data.commit as $c
        | $uploaded | all(.commit != $c)) | {
        revision: null, commit: .data.commit, time: .data.committed,
        current: false, where: .data.where}]
    | sort_by(.time | epoch) | reverse[]
    | {id: .commit, source: "memex", role: "history", kind: "version",
       basis: (.where | join(",")),
       links: [["change", $change.id], ["commit", .commit]],
       data: (del(.time) + {uploaded: (.revision != null)}), notes: {}}
    ' <<< "$change"
}

if [ "$1" == review -a $# -le 2 ]; then
  review "$2"
  exit
fi
if [ "$1" == history -a $# -le 2 ]; then
  history "$2"
  exit 0
fi
# A COMMIT may be any git revision, and defaults to HEAD
case "$1 $2" in
  "discussion locate" | "ci runs" | "code diff")
    if [ $# -eq 2 ]; then
      set -- "$1" "$2" HEAD
    fi
    if commit=$(git rev-parse -q --verify "$3^{commit}"); then
      set -- "$1" "$2" "$commit" "${@:4}"
    fi
    ;;
esac
if [ "$1" == bindings -a $# -eq 1 ]; then
  for role in code discussion tracker ci; do
    bindings "$role" | sed "s/^/$role /"
  done
  exit 0
fi
[ $# -ge 2 ] || die "$(usage)"
run "$@"
